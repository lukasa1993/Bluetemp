#!/usr/bin/env python3
"""Pinned build, serial flash, authenticated LAN OTA, and validation commands."""
import argparse
import hashlib
import hmac
import http.client
import io
import os
from pathlib import Path
import re
import secrets
import subprocess
import sys
import urllib.request
from urllib.parse import urlsplit
import zipfile

ROOT = Path(__file__).absolute().parent.parent
BIN = ROOT / ".tools/bin"
ELF = ROOT / "target/xtensa-esp32-none-elf/release/bluetemp"
IMAGE = ROOT / "target/bluetemp.bin"
KEY = ROOT / ".secrets/ota-key.hex"
REPORIGOR = Path(os.environ.get("REPORIGOR_ROOT", "/Users/l/_DEV/clean-code/reporigor"))
ENV = os.environ.copy()
ENV["PATH"] = f"{BIN}:{Path.home() / '.cargo/bin'}:{ENV.get('PATH', '')}"
ENV["ESPFLASH_SKIP_UPDATE_CHECK"] = "true"


def run(args, **kwargs):
    return subprocess.run([str(arg) for arg in args], cwd=ROOT, env=ENV, check=True, **kwargs)


def host():
    output = run(["rustc", "+stable", "-vV"], capture_output=True, text=True).stdout
    return re.search(r"^host: (.+)$", output, re.MULTILINE).group(1)


def download(url):
    with urllib.request.urlopen(url, timeout=120) as response:
        return response.read()


def setup():
    triple = host()
    if triple not in {"aarch64-apple-darwin", "x86_64-apple-darwin", "x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu"}:
        raise ValueError(f"Install espup 0.17.1 and espflash 4.6.0 manually for {triple}")
    BIN.mkdir(parents=True, exist_ok=True)
    for name, version in [("espup", "0.17.1"), ("espflash", "4.6.0")]:
        executable = BIN / name
        if executable.exists():
            actual = run([executable, "--version"], capture_output=True, text=True).stdout
            if version in actual:
                continue
        url = f"https://github.com/esp-rs/{name}/releases/download/v{version}/{name}-{triple}.zip"
        archive = download(url)
        with zipfile.ZipFile(io.BytesIO(archive)) as bundle:
            member = next(item for item in bundle.namelist() if Path(item).name == name)
            executable.write_bytes(bundle.read(member))
        executable.chmod(0o755)
        print(f"Installed {name} {version}; download SHA256 {hashlib.sha256(archive).hexdigest()}")
    run([BIN / "espup", "install", "--toolchain-version", "1.95.0.0", "--targets", "esp32",
         "--export-file", ROOT / ".tools/export-esp.sh"])


def toolchain():
    exports = ROOT / ".tools/export-esp.sh"
    if not exports.exists():
        raise ValueError("Run ./scripts/dev setup first")
    result = run(["sh", "-c", '. "$1"; env -0', "sh", exports], capture_output=True)
    for item in result.stdout.split(b"\0"):
        if b"=" in item:
            key, value = item.decode().split("=", 1)
            ENV[key] = value
    version = run(["rustc", "+esp", "--version"], capture_output=True, text=True).stdout
    if "(1.95.0.0)" not in version:
        raise ValueError("Expected Xtensa Rust 1.95.0.0; run ./scripts/dev setup")


def key_bytes(create=False):
    if not KEY.exists() and create:
        KEY.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        with KEY.open("x") as stream:
            KEY.chmod(0o600)
            stream.write(secrets.token_hex(32) + "\n")
        print("Generated .secrets/ota-key.hex; retain this key for future LAN updates")
    text = KEY.read_text().strip()
    if not re.fullmatch(r"[0-9a-fA-F]{64}", text):
        raise ValueError("OTA key must contain exactly 64 hexadecimal characters")
    return bytes.fromhex(text)


def image_options():
    return ["--chip", "esp32", "--min-chip-rev", "3.0", "--flash-mode", "dio",
            "--flash-size", "4mb", "--flash-freq", "40mhz", "--partition-table", "partitions.csv"]


def build():
    toolchain()
    ENV["BLUETEMP_OTA_KEY"] = key_bytes(create=True).hex()
    run(["cargo", "+esp", "rustc", "--release", "--locked", "-Zbuild-std=core", "--bin", "bluetemp",
         "--", "-C", "link-arg=-Wl,-Map=target/bluetemp.map"])
    run([BIN / "espflash", "save-image", *image_options(), ELF, IMAGE])
    image = IMAGE.read_bytes()
    validate_image(image)
    print(f"OTA image: {IMAGE} ({len(image)} bytes); SHA256 {hashlib.sha256(image).hexdigest()}")


def validate_image(image):
    if not 288 <= len(image) <= 0x1F0000:
        raise ValueError("Application image size is outside the OTA slot bounds")
    if image[0] != 0xE9 or not 1 <= image[1] <= 16 or image[12:14] != b"\0\0":
        raise ValueError("Expected an unmerged ESP32 application image")
    if image[32:36] != bytes.fromhex("3254cdab") or image[80:89] != b"bluetemp\0":
        raise ValueError("Expected a Bluetemp application descriptor")
    # espflash 4.6.0 appends an image SHA256. Check it before any upload.
    if image[23] != 1 or hashlib.sha256(image[:-32]).digest() != image[-32:]:
        raise ValueError("ESP application image SHA256 mismatch")


def board_info(port, manual=False):
    command = [BIN / "espflash", "board-info", "--port", port, "--non-interactive", "--no-stub", "--after", "no-reset"]
    if manual:
        command += ["--before", "no-reset"]
    result = run(command, capture_output=True, text=True)
    output = result.stdout + result.stderr
    print(output, end="")
    (ROOT / "target").mkdir(exist_ok=True)
    (ROOT / "target/board-info.txt").write_text(output)
    return output


def verify_board(output):
    revision = re.search(r"ESP32\s*\(revision\s+v?(\d+)\.(\d+)\)", output, re.IGNORECASE)
    size = re.search(r"Flash size:\s*(\d+)\s*(MB|KB)", output, re.IGNORECASE)
    if not revision or int(revision.group(1)) < 3:
        raise ValueError("This build requires original ESP32 revision v3.0+; no flash performed")
    if not size or size.group(2).upper() != "MB" or int(size.group(1)) < 4:
        raise ValueError("Could not verify at least 4 MB flash; no flash performed")


def flash(args):
    build()
    verify_board(board_info(args.port, args.manual))
    run([BIN / "espflash", "flash", *image_options(), "--port", args.port,
         "--non-interactive", "--before", "no-reset", "--after", "no-reset" if args.manual else "hard-reset",
         "--target-app-partition", "ota_0", "--erase-parts", "otadata", ELF])
    print("Serial install complete. Remove GPIO0-GND and reset EN to boot if using manual wiring.")


def ota(url):
    build()
    parsed = urlsplit(url)
    if parsed.scheme != "http" or not parsed.hostname or parsed.username or parsed.query or parsed.fragment or parsed.path not in {"", "/"}:
        raise ValueError("Use a device URL such as http://192.168.19.150")
    image = IMAGE.read_bytes()
    digest = hashlib.sha256(image).digest()
    manifest = b"bluetemp-ota-v1\0" + len(image).to_bytes(4, "big") + digest
    signature = hmac.new(key_bytes(), manifest, hashlib.sha256).hexdigest()
    connection = http.client.HTTPConnection(parsed.hostname, parsed.port or 80, timeout=180)
    try:
        connection.request("POST", "/ota", body=image, headers={
            "Content-Type": "application/octet-stream", "X-Image-SHA256": digest.hex(),
            "X-Image-Signature": signature, "Connection": "close"})
        response = connection.getresponse()
        body = response.read(4096).decode(errors="replace")
        print(f"HTTP {response.status}: {body}")
        if response.status != 200:
            raise ValueError("OTA was rejected; inspect the device serial log")
    finally:
        connection.close()


def host_tests(*options):
    previous = ENV.get("CARGO_TARGET_DIR")
    try:
        if "REPORIGOR_MUTANT_ID" in ENV:
            # Mutations run serially. Remove every application artifact before each test;
            # source restoration can preserve mtimes. Unchanged dependencies stay cached.
            ENV["CARGO_TARGET_DIR"] = str(ROOT / "target/mutation-tests")
            run(["cargo", "+stable", "clean", "--package", "bluetemp", "--package", "bluetemp-ota", "--target", host()])
        run(["cargo", "+stable", "test", "--workspace", "--locked", "--no-default-features", "--target", host(), *options])
    finally:
        ENV.pop("CARGO_TARGET_DIR", None)
        if previous is not None:
            ENV["CARGO_TARGET_DIR"] = previous


def check_tests():
    host_tests("--no-run")


def test():
    host_tests()
    run([sys.executable, "-m", "unittest", "discover", "-s", "tests", "-p", "test_*.py"])


def quality():
    toolchain()
    run(["cargo", "+stable", "fmt", "--all", "--check"])
    run(["cargo", "+esp", "clippy", "--workspace", "--release", "--locked", "-Zbuild-std=core", "--", "-D", "warnings"])
    test()
    coverage = ROOT / "target/quality/llvm-cov.json"
    coverage.parent.mkdir(parents=True, exist_ok=True)
    run(["cargo", "+stable", "llvm-cov", "--workspace", "--locked", "--no-default-features", "--target", host(),
         "--json", "--output-path", coverage])
    executable = REPORIGOR / "target/release/reporigor"
    if not executable.exists():
        run(["cargo", "+stable", "build", "--locked", "--release", "--target", host(), "--manifest-path", REPORIGOR / "Cargo.toml", "-p", "reporigor"])
        executable = REPORIGOR / "target" / host() / "release/reporigor"
    cargo = run(["rustup", "which", "--toolchain", "esp", "cargo"], capture_output=True, text=True).stdout.strip()
    command = [executable, "check", ".", "--language", "rust", "--backend", "native", "--allow-project-exec", "--cargo", cargo,
               "--coverage", coverage, "--run-mutations", "--test-command", "./scripts/dev test", "--format", "json"]
    with (coverage.parent / "reporigor.json").open("w") as report:
        result = subprocess.run([str(item) for item in command], cwd=ROOT, env=ENV, stdout=report, check=False)
    print(f"RepoRigor exit {result.returncode}; report: target/quality/reporigor.json")
    return result.returncode


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    for command in ["setup", "build", "test", "check-tests", "quality"]:
        commands.add_parser(command)
    for command in ["board-info", "flash"]:
        child = commands.add_parser(command)
        child.add_argument("--port", required=True)
        child.add_argument("--manual", action="store_true", help="GPIO0/EN wired manually; skip automatic reset")
    child = commands.add_parser("ota")
    child.add_argument("url")
    args = parser.parse_args()
    actions = {"setup": setup, "build": build, "test": test, "quality": quality, "check-tests": check_tests,
               "board-info": lambda: board_info(args.port, args.manual),
               "flash": lambda: flash(args), "ota": lambda: ota(args.url)}
    result = actions[args.command]()
    return result if isinstance(result, int) else 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        print(f"Error: {error}", file=sys.stderr)
        sys.exit(1)
